{
  "manifest_version": 3,
  "name": "MySessionBox",
  "version": "1.0.0",
  "description": "A Chrome extension for managing multiple sessions",

  "permissions": ["storage", "tabs", "cookies", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/index.js"
  },

  "action": {
    "default_title": "Open MySessionBox",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "popup/index.html"
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
